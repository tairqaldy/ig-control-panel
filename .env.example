# ─── Resurfly configuration ─────────────────────────────────────────────────
# Copy to .env for local dev, or set these as environment variables on Railway.

# Login (single user). Pick anything — this is your dashboard's door.
APP_USERNAME=admin
APP_PASSCODE=change-me-please

# OpenAI — analysis, transcription, embeddings, Ask. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: models (defaults shown). Any vision-capable chat model works for OPENAI_MODEL.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_ASK_MODEL=gpt-5.4-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBED_DIMS=512
# VISION_FRAMES=4

# Optional: pipeline tuning
# ANALYSIS_CONCURRENCY=3        # parallel items (1-8)
# KEEP_VIDEOS=false             # keep downloaded reels on disk (uses lots of space)
# MAX_VIDEO_MB=80               # skip videos bigger than this
# TRANSCRIBE_MAX_SECONDS=900    # skip transcription for very long videos

# Storage. Locally defaults to ./data. On Railway mount a volume at /data (RAILWAY_VOLUME_MOUNT_PATH is auto-detected).
# DATA_DIR=./data

# Server
# PORT=8080
# PUBLIC_URL=https://your-app.up.railway.app   # used in the harvester + webhook URLs (auto-detected on Railway)
# SESSION_SECRET=                               # auto-generated & persisted if empty
# SESSION_DAYS=30

# ─── Instagram: Connect (OAuth), DM automations, analytics (optional) ─────────
# See docs/AUTOMATIONS.md. Two paths:
#  (a) Connect button: set META_APP_ID + META_APP_SECRET (+ META_VERIFY_TOKEN, PUBLIC_URL) — Meta app → Instagram → API setup with
#      Instagram business login; redirect URI = $PUBLIC_URL/api/instagram/callback, deauthorize = /api/instagram/deauthorize,
#      data deletion = /api/instagram/delete, webhook = /api/webhooks/instagram. Tokens are stored encrypted and refreshed automatically.
#  (b) Manual token: IG_ACCESS_TOKEN + IG_USER_ID (owner account only via env; also editable in Settings → Integrations).
# META_APP_ID=
# META_APP_SECRET=                # Meta App Secret — also verifies webhook signatures (X-Hub-Signature-256)
# META_VERIFY_TOKEN=any-random-string-you-choose   # the webhook handshake token you enter in the Meta dashboard
# IG_ACCESS_TOKEN=                # long-lived token (60 days) — path (b)
# IG_USER_ID=                     # numeric professional account id — path (b)
# GRAPH_API_VERSION=v23.0

# ─── Hosted mode (resurfly.com) — leave everything below unset for the normal self-hosted app ───
# HOSTED=true                    # public signup, one tenant per account, trial + paid plans; the owner login above still works (tenant 1)
# SIGNUPS_ENABLED=true           # defaults to HOSTED; set false to close signups while keeping existing accounts working
# TRIAL_DAYS=3                   # free trial length; afterwards accounts fall back to browse/export-only until they upgrade
# OWNER_PLAN=owner               # plan applied to the owner account (tenant 1) at boot: owner (unlimited) | studio | pro | trial | free — lets you dogfood the limits
# SERVER_HARVEST_ENABLED=true    # Companion opt-in "harvest while my browser is closed" (stores the IG session encrypted, walks the saved feed every 12 h); defaults to HOSTED
# PUBLIC_URL=https://resurfly.com

# Paddle Billing (checkout runs in the browser with the client token; the server verifies webhooks and opens the customer portal)
# PADDLE_ENV=sandbox             # sandbox | production
# PADDLE_API_KEY=                # server-side API key (customer portal sessions, customer lookups)
# PADDLE_CLIENT_TOKEN=           # client-side token for Paddle.js
# PADDLE_WEBHOOK_SECRET=         # notification destination secret; webhook URL = $PUBLIC_URL/api/webhooks/paddle
# PADDLE_PRICE_PRO_MONTH=pri_...     # Pro $12/mo
# PADDLE_PRICE_PRO_YEAR=pri_...      # Pro $99/yr
# PADDLE_PRICE_STUDIO_MONTH=pri_...  # Studio $34/mo
# PADDLE_PRICE_STUDIO_YEAR=pri_...   # Studio $290/yr

# Nightly SQLite backups to Cloudflare R2 / any S3-compatible bucket (optional; disabled when unset)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=resurfly-media
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# BACKUP_HOUR_UTC=3
# BACKUP_KEEP=14
