# ─── Undig configuration ─────────────────────────────────────────────────
# Copy to .env for local dev, or set these as environment variables on Railway.

# Login (single user). Pick anything — this is your dashboard's door.
APP_USERNAME=admin
APP_PASSCODE=change-me-please

# OpenAI — analysis, transcription, embeddings, Ask. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: models (defaults shown). Any vision-capable chat model works for OPENAI_MODEL.
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_ASK_MODEL=gpt-5.4-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_EMBED_MODEL=text-embedding-3-small
# EMBED_DIMS=512
# VISION_FRAMES=4

# Optional: pipeline tuning
# ANALYSIS_CONCURRENCY=3        # parallel items (1-8)
# KEEP_VIDEOS=false             # keep downloaded reels on disk (uses lots of space)
# MAX_VIDEO_MB=80               # skip videos bigger than this
# TRANSCRIBE_MAX_SECONDS=900    # skip transcription for very long videos

# Storage. Locally defaults to ./data. On Railway mount a volume at /data (RAILWAY_VOLUME_MOUNT_PATH is auto-detected).
# DATA_DIR=./data

# Server
# PORT=8080
# PUBLIC_URL=https://your-app.up.railway.app   # used in the harvester + webhook URLs (auto-detected on Railway)
# SESSION_SECRET=                               # auto-generated & persisted if empty
# SESSION_DAYS=30

# ─── Instagram DM automations (optional, "ManyChat-lite") ─────────────────────
# See docs/AUTOMATIONS.md. All of these can also be entered in Settings → Automations.
# META_APP_SECRET=
# META_VERIFY_TOKEN=any-random-string-you-choose
# IG_ACCESS_TOKEN=
# IG_USER_ID=
# GRAPH_API_VERSION=v23.0
